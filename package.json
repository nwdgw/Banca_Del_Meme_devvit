{
  "name": "bancadelmeme-devvit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server/index.cjs",
    "lint": "tsc --noEmit",
