    "deploy": "npm run build && devvit upload"
  },
  "dependencies": {
    "@devvit/web": "^0.15.6"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "devvit": "latest",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.2"
  }
}
